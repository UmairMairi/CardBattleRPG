rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Own profile, cloud save, cards, inventory and blocked-players list.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /rankings/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /guilds/{document=**} {
      allow read, write: if request.auth != null;
    }

    // UGC reports (Google Play policy). Players can only file reports as themselves;
    // only the developer reads them (Firebase console / Admin SDK).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
